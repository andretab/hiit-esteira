<?xml version="1.0"?>
<!--
    Manifest do app Connect IQ "HIIT Esteira".
    - type="watch-app": device app (não data field), pois precisamos de tela própria,
      Timer, vibração e tom a cada troca de bloco.
    - minApiLevel 3.2.0: cobre Attention.playTone/vibrate, Application.Storage e
      todos os Forerunner/Fenix/Epix/Venu dos últimos anos.
    - Permissões: Fit (gravar o treino como atividade Corrida > Esteira), FitContributor
      (campos extras na atividade), Sensor (frequência
      cardíaca) e UserProfile (peso, idade, sexo e zonas de FC, para calorias).
      Storage e Attention não exigem.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="f1998ea00ebd4a06983b7a3ccefc974f"
                    type="watch-app"
                    name="@Strings.AppName"
                    entry="HiitEsteiraApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.2.0">
        <iq:products>
            <!-- Forerunner -->
            <iq:product id="fr165"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <!-- Fenix / Epix -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="epix2"/>
            <!-- Venu -->
            <iq:product id="venu3"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="FitContributor"/>
            <iq:uses-permission id="Sensor"/>
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>por</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
