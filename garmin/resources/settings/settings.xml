<!-- Tela de configurações do app no Garmin Connect (celular). -->
<settings>
    <setting propertyKey="@Properties.ritmoMax" title="@Strings.TituloRitmo" prompt="@Strings.PromptRitmo">
        <settingConfig type="numeric" min="8" max="25" />
    </setting>
    <setting propertyKey="@Properties.duracaoMin" title="@Strings.TituloDuracao" prompt="@Strings.PromptDuracao">
        <settingConfig type="numeric" min="10" max="50" />
    </setting>
    <setting propertyKey="@Properties.unidade" title="@Strings.TituloUnidade">
        <settingConfig type="list">
            <listEntry value="0">@Strings.UnidadeKmh</listEntry>
            <listEntry value="1">@Strings.UnidadePace</listEntry>
        </settingConfig>
    </setting>
</settings>
